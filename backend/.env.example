# Copy this file to .env and fill in real values before running docker-compose.
# Never commit .env to version control.

# Shared JWT secret — use a long random string in production
# Generate with: openssl rand -hex 32
JWT_SECRET=

# JWT token lifetime in seconds (default: 86400 = 24h)
JWT_TTL_SECONDS=86400

# PostgreSQL credentials shared across all databases
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# MinIO (S3-compatible storage) root credentials
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=observations
MINIO_REGION=us-east-1

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000
